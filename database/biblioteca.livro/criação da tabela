-- Script de criação da tabela biblioteca.livro
CREATE TABLE biblioteca.livro (
    id_livro INT NOT NULL AUTO_INCREMENT,
    titulo VARCHAR(255) NOT NULL,
    editora VARCHAR(100),
    ano_publicacao INT,
    isbn VARCHAR(13) UNIQUE,
    id_categoria INT NOT NULL,
    quantidade_total INT NOT NULL DEFAULT 0,
    quantidade_disponivel INT NOT NULL DEFAULT 0,
    
    -- Definição de Chave Primária
    CONSTRAINT PK_livro PRIMARY KEY (id_livro),
    
    -- Definição de Chave Estrangeira (ajuste o nome da tabela de categorias se necessário)
    CONSTRAINT FK_livro_categoria FOREIGN KEY (id_categoria) 
        REFERENCES biblioteca.categoria(id_categoria)
);